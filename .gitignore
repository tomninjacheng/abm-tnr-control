# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Editors ---
.vscode/
.idea/
*.swp
*~

# --- NetLogo backups & temp files ---
*.nlogo.bak
*.nlogo3d.bak
*.tmp

# --- BehaviorSpace / experiment output ---
experiments/
results/
output/
*.csv
*.tsv
*.xls
*.xlsx

# --- Generated plots / figures ---
*.png
*.jpg
*.jpeg
*.pdf
!docs/**/*.png

# --- Exceptions: committed deliverables ---
# Note: !results/foo requires the parent `results/` ignore pattern to not
# fully negate — git honours deeper negations if the directory itself isn't
# excluded. To make the sensitivity exceptions work we must un-ignore the
# directory first, then re-ignore everything inside it, then un-ignore the
# specific files we want.
!results/
results/*
!results/sensitivity_oat.py
!results/sensitivity_oat_results.csv
!results/sensitivity_oat_results.json
!results/sensitivity_tornado.png

# --- Environment / local config ---
.env
.env.local
